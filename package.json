{
  "name": "cccdev",
  "version": "1.0.3",
  "description": "Chrome extension for Cocos Creator preview debugging",
  "license": "MIT",
  "author": "potato47",
  "repository": {
    "type": "git",
    "url": "https://github.com/potato47/ccc-devtools"
  },
  "bin": {
    "cccdev": "./bin/cccdev.ts"
  },
  "files": [
    "bin/",
    "src/",
    "template/"
  ],
  "scripts": {
    "build": "bun run --cwd packages/cccdev-template-3x icons && bun run --cwd packages/cccdev-template-3x build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "typescript": "^5.9.3"
  }
}

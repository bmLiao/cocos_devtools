{
  "manifest_version": 3,
  "name": "Cocos DevTools",
  "version": "1.0.3",
  "description": "在独立弹窗中查看 Cocos Creator 预览页的节点树、属性与 Profiler",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 / 关闭 Cocos DevTools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*", "file://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["assets/index.js", "assets/style.css"],
      "matches": ["http://*/*", "https://*/*", "file://*/*"]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Cocos DevTools",
  "version": "0.0.0",
  "description": "Cocos Creator 預覽除錯（節點樹／屬性／Profiler）與全站便條紙；右鍵圖示開啟選單",
  "author": "BM <cit49836085@gmail.com>",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "右鍵開啟選單（便條紙／DevTools／視窗模式）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "storage", "unlimitedStorage", "activeTab", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*", "file://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["snippet/styles.css"],
      "js": ["snippet/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/index.js", "assets/style.css", "assets/*.json"],
      "matches": ["http://*/*", "https://*/*", "file://*/*"]
    }
  ]
}

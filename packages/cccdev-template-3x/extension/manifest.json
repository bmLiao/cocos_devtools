{
  "manifest_version": 3,
  "name": "Cocos DevTools",
  "version": "0.0.0",
  "description": "在獨立彈窗中檢視 Cocos Creator 預覽頁的節點樹、屬性與 Profiler",
  "author": "BM <cit49836085@gmail.com>",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "開啟 / 關閉 Cocos DevTools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*", "file://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["assets/index.js", "assets/style.css"],
      "matches": ["http://*/*", "https://*/*", "file://*/*"]
    }
  ]
}

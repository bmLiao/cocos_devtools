      },
      {
        "label": "置中偏移",
        "keys": ["horizontalCenter", "verticalCenter"],
        "cells": ["水平", "垂直"]
      },
      {
        "label": "邊距為絕對值",
        "keys": ["isAbsoluteTop", "isAbsoluteBottom", "isAbsoluteLeft", "isAbsoluteRight"],
        "cells": ["上", "下", "左", "右"]
      },
      {
        "label": "置中為絕對值",
        "keys": ["isAbsoluteHorizontalCenter", "isAbsoluteVerticalCenter"],
        "cells": ["水平", "垂直"]
      }
    ],
    "alignMode": "對齊模式",
    "isAlignTop": "對齊上",
    "isAlignBottom": "對齊下",
    "isAlignLeft": "對齊左",
    "isAlignRight": "對齊右",
    "isAlignVerticalCenter": "垂直置中",

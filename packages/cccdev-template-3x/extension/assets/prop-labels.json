{
  "_comment": "屬性顯示名稱對照表。不進 JS 壓縮，建置時原樣複製到 dist/assets/prop-labels.json。改完重新整理擴充並重開彈窗即可。$name 為元件面板標題；* 為所有元件共用。也可為自訂腳本類名加條目。",
  "cc.Node": {
    "$name": "節點",
    "$groups": [
      {
        "label": "座標",
        "keys": [
          "x",
          "y",
          "z"
        ]
      },
      {
        "label": "縮放",
        "keys": [
          "scaleX",
          "scaleY",
          "scaleZ"
        ]
      }
    ],
    "layer": "圖層",
    "x": "X",
    "y": "Y",
    "z": "Z",
    "scaleX": "縮放 X",
    "scaleY": "縮放 Y",
    "scaleZ": "縮放 Z"
  },
  "cc.UITransform": {
    "$name": "UITransform",
    "$groups": [
      {
        "label": "寬高",
        "keys": [
          "width",
          "height"
        ]
      },
      {
        "label": "錨點",
        "keys": [
          "anchorX",
          "anchorY"
        ]
      }
    ],
    "width": "寬度",
    "height": "高度",
    "anchorX": "錨點 X",
    "anchorY": "錨點 Y",
    "priority": "優先順序"
  },
  "cc.Label": {
    "$name": "Label",
    "$keys": [
      "string",
      "font",
      "useSystemFont",
      "color",
      "fontSize",
      "lineHeight",
      "spacingX",
      "horizontalAlign",
      "verticalAlign",
      "overflow",
      "enableWrapText",
      "isBold",
      "isItalic",
      "isUnderline",
      "enableOutline",
      "outlineColor",
      "outlineWidth",
      "enableShadow",
      "shadowColor",
      "shadowOffset",
      "shadowBlur",
      "cacheMode"
    ],
    "$groups": [
      {
        "label": "字級",
        "keys": ["fontSize", "lineHeight", "spacingX"],
        "cells": ["大小", "行高", "字距"]
      },
      {
        "label": "對齊",
        "keys": ["horizontalAlign", "verticalAlign"],
        "cells": ["水平", "垂直"]
      },
      {
        "label": "樣式",
        "keys": ["isBold", "isItalic", "isUnderline"],
        "cells": ["粗體", "斜體", "底線"]
      },
      {
        "label": "描邊",
        "keys": ["enableOutline", "outlineWidth"],
        "cells": ["啟用", "寬度"]
      }
    ],
    "string": "文字",
    "font": {
      "label": "字型",
      "display": "name",
      "print": true,
      "show": true
    },
    "useSystemFont": "系統字",
    "color": "顏色",
    "fontSize": "字級",
    "lineHeight": "行高",
    "spacingX": "字距",
    "horizontalAlign": "水平對齊",
    "verticalAlign": "垂直對齊",
    "overflow": "溢位",
    "enableWrapText": "自動換行",
